# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Security & Sessions
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=8h
SESSION_SECRET=super-secret-session-key-replace-in-production

# PostgreSQL Database Configuration
# If DATABASE_URL is provided, backend connects via standard PostgreSQL pool (pg).
# If left empty in local dev, backend automatically boots the embedded PostgreSQL engine (.pgdata)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scorecard_db
PGDATA_DIR=./.pgdata

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5
